{
  "info": {
    "name": "Catálogo API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "produto_id", "value": "" }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"email\":\"loja@catalogo.com\",\"senha\":\"senha123\"}" },
        "url": "{{base_url}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const resposta = pm.response.json()",
              "pm.collectionVariables.set('token', resposta.token)",
              "pm.test('Login retorna token', () => pm.expect(resposta.token).to.be.a('string'))"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar produtos",
      "request": { "method": "GET", "url": "{{base_url}}/produtos" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status é 200', () => pm.response.to.have.status(200))",
              "pm.test('Retorna lista paginada', () => pm.expect(pm.response.json().produtos).to.be.an('array'))"
            ]
          }
        }
      ]
    },
    {
      "name": "Criar produto (autenticado)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"nome\":\"Teclado Mecânico\",\"sku\":\"TEC-010\",\"preco\":349.90,\"estoque\":15}" },
        "url": "{{base_url}}/produtos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status é 201', () => pm.response.to.have.status(201))",
              "pm.test('Produto retornado tem id', () => pm.expect(pm.response.json().id).to.exist)",
              "pm.collectionVariables.set('produto_id', pm.response.json().id)"
            ]
          }
        }
      ]
    },
    {
      "name": "Criar produto com preço negativo (erro)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"nome\":\"Produto Inválido\",\"sku\":\"INV-001\",\"preco\":-10,\"estoque\":5}" },
        "url": "{{base_url}}/produtos"
      },
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('Preço negativo retorna 422', () => pm.response.to.have.status(422))"] }
        }
      ]
    },
    {
      "name": "Excluir produto criado",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/produtos/{{produto_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('Exclusão retorna 204', () => pm.response.to.have.status(204))"] }
        }
      ]
    }
  ]
}
